# Normalise text files to LF regardless of the checkout platform.
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.mjs   text eol=lf
*.md    text eol=lf

# Binary assets: never touch.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.ico   binary
*.pdf   binary
*.mp4   binary
*.mov   binary
*.woff  binary
*.woff2 binary
